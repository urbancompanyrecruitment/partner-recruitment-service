NODE_ENV=test
PORT=3006
LOG_LEVEL=silent

# postgres://user:password@host:port/database
DATABASE_URL=postgres://recruitment:recruitment@127.0.0.1:5432/partner_recruitment_test

# 32+ random bytes, hex. Generate with: openssl rand -hex 32
SESSION_SECRET=test-session-secret-test-session-secret-0000
PHONE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PHONE_CHECKSUM_KEY=test-checksum-key-test-checksum-key-0000

# Cookies are sent only over https when true (set true in staging / production)
COOKIE_SECURE=false

# provider-onboarding-service. Leave ONBOARDING_BASE_URL empty to stub the calls locally.
ONBOARDING_BASE_URL=
ONBOARDING_CLIENT_ID=partner-recruitment-service
ONBOARDING_CATEGORY_KEY=cleaning
ONBOARDING_CITY_KEY=singapore
ONBOARDING_SOURCE_TYPE=recruitment_portal

# Google Sheet that receives one row per sign-up (Apps Script web app; setup steps in the README, "Sign-up sheet").
# Leave the URL empty to skip the sheet.
SIGNUP_SHEET_WEBHOOK_URL=
SIGNUP_SHEET_WEBHOOK_SECRET=

# Values written into the CSV that admins upload at the ops dashboard /lead/bulkAdd page.
# The category key is the Urban Company provider category of the partners; the download is refused until it is set.
# Source type is third_party or offline_activity. Experiment name: lowercase letters, digits and underscores only.
OPS_LEAD_UPLOAD_CITY_KEY=city_singapore_v2
OPS_LEAD_UPLOAD_CATEGORY_KEY=test_cleaning_category
OPS_LEAD_UPLOAD_SOURCE_TYPE=third_party
OPS_LEAD_UPLOAD_EXPERIMENT_NAME=sg_recruitment_portal

LOCK_TTL_HOURS=72

CRON_SECRET=test-cron-secret-0123456789
