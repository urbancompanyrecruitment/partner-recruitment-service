NODE_ENV=development
PORT=3006
LOG_LEVEL=info

# mysql://user:password@host:port/database
DATABASE_URL=mysql://recruitment:recruitment@127.0.0.1:3306/partner_recruitment

# 32+ random bytes, hex. Generate with: openssl rand -hex 32
SESSION_SECRET=
PHONE_ENCRYPTION_KEY=
PHONE_CHECKSUM_KEY=

# Cookies are sent only over https when true (set true in staging / production)
COOKIE_SECURE=false

# Google Identity Services client id used by the admin (business) sign-in; must match the frontend
GOOGLE_CLIENT_ID=614433729343-srjrrlulfgq0c4svp8ktrljid44qimia.apps.googleusercontent.com
ADMIN_EMAIL_DOMAINS=urbancompany.com,urbanclap.com

# provider-onboarding-service. Leave ONBOARDING_BASE_URL empty to stub the calls locally.
ONBOARDING_BASE_URL=
ONBOARDING_CLIENT_ID=partner-recruitment-service
ONBOARDING_CATEGORY_KEY=cleaning
ONBOARDING_CITY_KEY=singapore
ONBOARDING_SOURCE_TYPE=recruitment_portal

LOCK_TTL_HOURS=48
SLOT_CAPACITY=4
